# Environment Variables Configuration
# Copy this file to .env and adjust variables as needed.
# All paths must reside outside OneDrive and the repository root.

# Base directory for all application runtime data (defaults to %LOCALAPPDATA%\pokemon2 on Windows)
DATA_DIR=

# SQLite database file path (defaults to $DATA_DIR/pokesearch.db)
DATABASE_PATH=

# Directory for raw downloaded card cache (defaults to $DATA_DIR/raw)
RAW_CACHE_DIR=

# Cargo build target directory (defaults to $DATA_DIR/target)
CARGO_TARGET_DIR=

# Engine CLI binary path (defaults to $CARGO_TARGET_DIR/release/ptcg-cli.exe on Windows)
ENGINE_BIN=

# HTTP API server listen port (default: 8000)
API_PORT=8000

# Web frontend development server port (default: 5173)
WEB_PORT=5173

# Enable background scheduler (0: disabled, 1: enabled)
SCHEDULER_ENABLED=0

# Log verbosity level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Node execution environment (development | production | test)
NODE_ENV=development

# Optional Limitless API Key for tournament sync
LIMITLESS_API_KEY=

# Optional Anthropic API Key for LLM assistant
ANTHROPIC_API_KEY=

# Optional custom base URL for LLM provider
LLM_BASE_URL=

# Optional LLM model identifier
LLM_MODEL=
