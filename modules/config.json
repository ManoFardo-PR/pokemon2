{
  "github_repo": "",
  "github_token_env": "GITHUB_TOKEN",
  "continue_cli_path": "npx @continuedev/cli",
  "continue_config": "../.continue/config.yaml",
  "repo_root": "..",
  "allowed_paths": ["tests/cpf_validator", "tests/hello_demo"],
  "forbidden_paths": ["modules", ".git", ".continue"],
  "project_conventions": "Each demo lives in its own folder under tests/<demo>/; production code in <demo>/src/<module>.py (package with __init__.py), tests as <demo>/test_<module>.py importing `from src.<module> import ...`.",
  "test_command": "python -m unittest discover -s tests/hello_demo -v",
  "typecheck_command": "python -m compileall -q tests",
  "trigger_label": "tdd-queue",
  "failed_label": "tdd-failed",
  "max_retries": 3,
  "verify_stages": [1, 2, 3],
  "verify_max_rounds": 2,
  "audit_mode": "llm",
  "max_inject_chars": 40000,
  "max_diff_chars": 8000,
  "poll_interval_sec": 10,
  "cli_timeout_sec": 300,
  "cli_retries": 1,
  "cli_retry_wait_sec": 15,
  "live_log": "logs/live.log",
  "live_log_max_mb": 20,
  "console_verbose": false,
  "auto_countdown_sec": 0
}
